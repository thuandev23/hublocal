ions":[{"name":"Bữa sáng","enabled":true},{"name":"Bữa trưa","enabled":true},{"name":"Ăn tối một mình","enabled":true}]},{"id":"accessibility","name":"Phù hợp cho người khuyết tật","options":[{"name":"Chỗ ngồi cho xe lăn","enabled":false}]},{"id":"offerings","name":"Dịch vụ","options":[{"name":"Nhà hàng thức ăn nhanh","enabled":true}]},{"id":"dining_options","name":"Lựa chọn ăn uống","options":[{"name":"Bữa sáng","enabled":true},{"name":"Bữa nửa buổi","enabled":true},{"name":"Bữa trưa","enabled":true},{"name":"Bữa tối","enabled":true},{"name":"Dịch vụ ăn uống","enabled":true},{"name":"Phục vụ tại bàn","enabled":true}]},{"id":"amenities","name":"Tiện nghi","options":[{"name":"Nhà vệ sinh","enabled":true}]},{"id":"atmosphere","name":"Bầu không khí","options":[{"name":"Thông thường","enabled":true}]},{"id":"crowd","name":"Khách hàng","options":[{"name":"Nhóm","enabled":true}]},{"id":"children","name":"Trẻ em","options":[{"name":"Phù hợp cho trẻ em","enabled":true}]},{"id":"parking","name":"Bãi đỗ xe","options":[{"name":"Bãi đỗ xe miễn phí","enabled":true},{"name":"Chỗ đỗ xe","enabled":false},{"name":"Đỗ xe miễn phí trên đường","enabled":true}]}],"user_reviews":[{"Name":"Bao Hoang","ProfilePicture":"https://lh3.googleusercontent.com/a-/ALV-UjV156SWfO1fzsdLJART5gwLFzA4VGlsoheXUZoFBm9uSOy1LL-t=s120-c-rp-mo-ba12-br100","Rating":5,"Description":"Thơm đậm mùi xả\nHợp với người miền Trung!\nRiêng gân vàng còn khá dai, khuyến khích mọi người ăn thập cẩm mỗi thứ 1 ít cho biết.\nMình tò mò ăn gân-chả (chả cua là đặc sản của quán) nhưng khi gọi ra chỉ có 1 cục chả, còn lại là gân!\nChả của ăn cũng okay!\nNói chung ăn ổn nhưng không hợp khẩu vị mình lắm!\nCho quán 5 sao chúc quán cải thiện lại gân cho mềm hơn và nếu tô gân-chả thì bớt gân và thêm chả nha!","Images":["https://lh3.googleusercontent.com/grass-cs/ACvplmNyHbYCqeC5SNBIoWIvN9VMq6v7Ri-EwtKP2rxhHHVXmC5Kd0tjP63dnLhHlTWBkloa6FnIl5oorGzPU4bPk_pLkVjLHg-7-wgdEyUkMdTtQ4JizndNMfYnQgnOk7DTmcGyf8yYbaqJg0c9=k-no","https://lh3.googl