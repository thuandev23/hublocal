thường","enabled":true}]},{"id":"crowd","name":"Khách hàng","options":[{"name":"Nhóm","enabled":true}]},{"id":"planning","name":"Lên kế hoạch","options":[{"name":"Nhận đặt chỗ","enabled":false}]},{"id":"payments","name":"Thanh toán","options":[{"name":"Chỉ nhận tiền mặt","enabled":true}]},{"id":"children","name":"Trẻ em","options":[{"name":"Phù hợp cho trẻ em","enabled":true}]},{"id":"parking","name":"Bãi đỗ xe","options":[{"name":"Bãi đỗ xe miễn phí","enabled":true},{"name":"Đỗ xe miễn phí trên đường","enabled":true}]}],"user_reviews":[{"Name":"frog","ProfilePicture":"https://lh3.googleusercontent.com/a-/ALV-UjUAQtzj_cLQFkLR6_VjIEmwuCX3chI7wTrzYAVQlHDl-PTkWYzl=s120-c-rp-mo-ba12-br100","Rating":4,"Description":"Quán cơm tấm drama nhất Thủ Đức.\nNgay khi nhỏ em đồng nghiệp ăn cơm tấm cô Chi về rồi nhận xét không ngon bằng cơm tấm Thành Thủ Đức tui đã lên search GG và bất ngờ là nó bị đánh giá 3,8 với những bình luận tiêu cực như mắc, chảnh...\nTui đón xe bus số 8 lên chợ Thủ Đức sớm. Con hẻm 942 nhỏ xíu ở đoạn tiếp giáp Kha Vạn Cân nhưng đi vào trong thì khá rộng rãi.\nTrong con hẻm này có hai quán cơm tấm nổi tiếng là cơm tấm Đại Đồng và cơm tấm Thành.\nQuán cơm tấm Thành có mặt tiền khá rộng rãi. Lúc tui đến mới 6g30 mà xe đã đậu kín trước mặt. Tui gọi sườn bì chả.\nĐiểm ngon của quán này chắc chắn là cơm tấm khô ráo, nước mắm sánh kẹo ( quán này theo trường phái nước mắm kẹo). Nước mắm chắc ngon với nhiều người vì tui nghe một cô mua mang về xin thêm bịch nước mắm và than phiền với chủ quán là đứa con húp nước mắm trừ cơm hay sao mà lúc nào cũng dặn xin thêm.\nMiếng sườn ướp mật ong được nướng vừa tới mềm mại nhưng khá mỏng. Bì trộn ngon, chả bình thường.\nNhiều người than phiền đợi lâu, thái độ nhân viên chảnh nhưng may sao đầu ngày tui không bị. Mọi thứ đều rất bình thường. Nhân viên vui vẻ, món lên nhanh ( chưa tới 5 phút)\nĐiểm dở là mắc. Dĩa 3 món của tui giá 65k cao hơn nhiều quán cơm tấm danh giá ở Sài Gòn.\nThật ra nếu bạn đã từng ăn những quán danh bất hư truyền với trường phái nước mắm kẹo như quán Dung Nguyễn Văn Lạc, cơm tấm Tài - Nguyễn An Ninh thì cơm tấm Thành này chỉ là cái tên nhỏ bé nơi Thủ Đức xa xôi","Images":["https://lh3.googleusercontent.com/grass-cs/ACvplmO-3No4N_MLX-GB0SgbxpmMWnwWxuusfVj8y8rc4KdkSlhpvXZtgJ4zu-3cJ9dStSILyBeNKJgciYBXDh0uPyR2V3wNDyrFPnaRL4TayxhY-zXxd2b5xgMBMvmrILAUiyn2KDjyUO6t3-4=k-no","https://lh3.googleusercontent.com/grass-cs/ACvplmOT5bmo_sNSlFPo2kgPtLzXTifldrR5Y6jOjNX4qsOs1FsQknrUxjgupy0SPVybcjZl6ePBsKIsKdG7iVW5GhIjISy5OK3JllFDRH7BIW6SX9cB9uRiGc-8Hfnnu3YAoVVqGtSOkAp1yjRB=k-no","https://lh3.googleusercontent.com/grass-cs/ACvplmN_tGVSN8T7k-dTN2rAsDdkpHawioZEPyhXpKZfWBiL-wxnb5fZEg0P8d4Wc3ilRXJBIResKhCJlTqi1AIiys-jV-lnsHHuE3VgdK3ro56B2h5tURtOikUlNepJ7LkG4BUxRiyGim1pCG0=k-no","https://lh3.googleusercontent.com/grass-cs/ACvplmPGKX-DmF6au8VIIEyr4JN3RztwHEGEVyJJC5d3bcsO_rYWAS9gkszZ7uQCGB8f4NtDmQHevfC5d4iHWZiLFOaUeOT9bbJk_328P_RoOxCxEttINUI8YiX0SWjiwPstbn5XfXAT-ISOb1fF=k-no","https://lh3.googleusercontent.com/grass-cs/ACvplmNS8iUJdQSGqQfPAK6gzzfrwgMoSKMgVlfcvUuj8zYuA1dWWQbWft3jAPHox6L3aQDPMGLvvzeWL9pJRJ-XusGn6RTwt56k8BpE3TN8veck-gU0W3qrKzLGJ5NLL509e-eG-0UpMWiqWoI=k-no"],"When":"một tháng trước","review_id":"Ci9DQUlRQUNvZENodHljRjlvT25nM1NVSjJhSFZ1VkdweFQyRnNRMkk0U0dkWU9VRRAB","source":"Google","rating_scale":5,"rating_float":4,"author_url":"https://www.google.com/maps/contrib/114582521216560586252/reviews?hl=vi","posted_at_unix_micros":1786027025083109,"updated_at_unix_micros":1786027025083109,"language":"vi","translated_lang":"","text_original":"Quán cơm tấm drama nhất Thủ Đức.\nNgay khi nhỏ em đồng nghiệp ăn cơm tấm cô Chi về rồi nhận xét không ngon bằng cơm tấm Thành Thủ Đức tui đã lên search GG và bất ngờ là nó bị đánh giá 3,8 với những bình luận tiêu cực như mắc, chảnh...\nTui đón xe bus số 8 lên chợ Thủ Đức sớm. Con hẻm 942 nhỏ xíu ở đoạn tiếp giáp Kha Vạn Cân nhưng đi vào trong thì khá rộng rãi.\nTrong con hẻm này có hai quán cơm tấm nổi tiếng là cơm tấm Đại Đồng và cơm tấm Thành.\nQ