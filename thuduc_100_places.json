","enabled":true},{"name":"Wi-Fi","enabled":true}]},{"id":"atmosphere","name":"Bầu không khí","options":[{"name":"Ấm cúng","enabled":true},{"name":"Thông thường","enabled":true},{"name":"Yên tĩnh","enabled":true}]},{"id":"crowd","name":"Khách hàng","options":[{"name":"Dành cho gia đình","enabled":true},{"name":"Nhóm","enabled":true},{"name":"Sinh viên","enabled":true}]},{"id":"planning","name":"Lên kế hoạch","options":[{"name":"Yêu cầu hẹn trước","enabled":true},{"name":"Nhận đặt chỗ","enabled":true}]},{"id":"payments","name":"Thanh toán","options":[{"name":"Thanh toán di động qua NFC","enabled":true},{"name":"Thẻ ghi nợ","enabled":true},{"name":"Thẻ tín dụng","enabled":true,"values":["Thẻ MasterCard","Thẻ VISA"]}]},{"id":"children","name":"Trẻ em","options":[{"name":"Ghế cao cho bé","enabled":true},{"name":"Phù hợp cho trẻ em","enabled":true},{"name":"Thực đơn dành cho trẻ em","enabled":true}]},{"id":"parking","name":"Bãi đỗ xe","options":[{"name":"Bãi đỗ xe miễn phí","enabled":true},{"name":"Chỗ đỗ xe","enabled":false},{"name":"Dịch vụ đỗ xe","enabled":true},{"name":"Đỗ xe miễn phí trên đường","enabled":true}]},{"id":"pets","name":"Thú cưng","options":[{"name":"Cho phép mang theo chó","enabled":true},{"name":"Cho phép mang theo chó bên ngoài","enabled":true},{"name":"Được mang chó vào trong","enabled":true}]}],"user_reviews":[{"Name":"Raymond","ProfilePicture":"https://lh3.googleusercontent.com/a-/ALV-UjUrVzng8Utgnab6WsGR7U7r3bakymQz8hcJVJWrDxU31U0HDX4=s120-c-rp-mo-ba12-br100","Rating":5,"Description":"Quán cafe 24h núp hẻm siêu rộng, đầy đủ tiện ích để chạy deadline và giải trí tại Thủ Đức!\nDù núp hẻm nhưng quán sở hữu diện tích siêu rộng với 3 tầng lầu, chia làm cả khu vực trong nhà máy lạnh mát rượi lẫn ngoài sân vườn nhiều cây xanh kèm hồ cá rất chill. Decor theo phong cách cổ điển, vintage kết hợp ánh đèn ấm áp mang lại cảm giác dễ chịu. Quán trang bị đầy đủ ổ điện, không gian sáng và trưa rất yên tĩnh, cực kỳ lý tưởng cho những ai đi học bài một mình hoặc ôm laptop làm việc.\nTiện ích giải trí phong phú: Điểm độc đáo là quán có sẵn board game, gắp thú, tô tượng để xả stress khi chạy deadline mệt mỏi. Ngoài ra, cuối tuần quán còn có xem Tarot và đêm nhạc Acoustic miễn phí vào tối thứ 7, CN hàng tuần từ 20h vô cùng nhộn nhịp.\nMenu dao động từ 35k - 60k, mức giá này là quá hợp lý cho một quán mở cửa 24h và không thu thêm phụ phí. Món ăn khá đa dạng, mọi người nên thử cà phê cốt dừa, bạc xỉu ngọt nhẹ hoặc trà lài mãng cầu.\nChú bảo vệ giữ xe siêu dễ thương, thân thiện và nhớ mặt khách quen luôn làm mình thấy rất ấm lòng.\nVì diện tích quán quá rộng nên dường như khâu quét dọn chưa được bao quát hết, dẫn đến việc nhiều góc trong quán vẫn còn hơi bẩn, cần được chú trọng lau chùi hơn. Chiều tối quán khá đông đúc nên sẽ phù hợp cho nhóm bạn tụ tập hơn, ai cần tập trung cao độ thì nên chọn đi vào khung giờ sáng hoặc trưa nhé.\nTổng kết: Một không gian đa năng, thoải mái từ sáng đến đêm với giá cả phải chăng.","Images":["https://lh3.googleusercontent.com/grass-cs/ACvplmM-t8aISFmhbNJ_I2xPu-eTHHQyG7Hc-4mjNFUFAHI3R1zE9FYlzJmEikK7sUDo0iPE_Qaf7a2su4jwGaEEYcKsUFp-xQospTK8z-mRbOly3E7F0upRhmetnDHeD-gaQJz526GJ3vKJWX9o=k-no","https://lh3.googleusercontent.com/grass-cs/ACvplmPXG6Psjrp3QWCLqn5S6RpVY6kA9weWi5IP_RuFSkjWEcQKd7Asi_wb_Z8PL38WnZtqRXZVBcyJqn1xiVv90XSjd9ZQpdu7-n0BgWoacnFWX6Mye3PSKDrtJ8sBPf7WIma7otLVuw2NjXcJ=k-no","https://lh3.googleusercontent.com/grass-cs/ACvplmPmUWQXvTS1fgJ1S_OBwjCbrTeiyHcsjmlxO6uVjvg_GEsr1eCGmAeSMH2OQX10NFh6F-ynhwLXXz-xt6F2J1v20M7MmR3Ckmxbv-3ZdWaHm_bvnGqg0er8a89dcM68eLt7RkU6sGxtIHDP=k-no","https://lh3.googleusercontent.com/grass-cs/ACvplmOPAop8yAMO7Nuh14btIXxDhouinTDZ0YyhNhyUFk5Gnv_Fps_9ujjacUNKNEQMgZKuDyJTkhLc3JLH58uJp9Rc2UAOnxIS2-25YCjnj_ToVpL2ORJcNApcjY16-4eUEvZPFbGSYoWzR8c=k-no","https://lh3.googleusercontent.com/grass-cs/ACvplmMKpjDBg_zDhXeutVHGKAKvet4sMfyH8BPyYk8OJIHeyKrCwcnxZjCaA7NWeRW2MNMGisn5DpLAUAn6y2-3-RoM4wJoHCgXZggmGGjX2xLbGB-f_6KLtMSZ0M2EiAFBMSetjzsgKHBjBv8I=k-no","https://lh3.googleusercontent.