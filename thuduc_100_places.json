"enabled":true},{"name":"Sinh viên","enabled":true}]},{"id":"planning","name":"Lên kế hoạch","options":[{"name":"Nhận đặt chỗ","enabled":true}]},{"id":"payments","name":"Thanh toán","options":[{"name":"Chỉ nhận tiền mặt","enabled":true}]},{"id":"parking","name":"Bãi đỗ xe","options":[{"name":"Bãi đỗ xe miễn phí","enabled":true},{"name":"Chỗ đỗ xe","enabled":false},{"name":"Đỗ xe miễn phí trên đường","enabled":true}]}],"user_reviews":[{"Name":"Quỳnh Như Nguyễn","ProfilePicture":"https://lh3.googleusercontent.com/a-/ALV-UjUBgaSbcjWbQdI5DjvXxTbwDaTKBMqADjqip4gOIQdYv6t9XLfx=s120-c-rp-mo-ba12-br100","Rating":5,"Description":"Quán nhậu bình dân này là địa điểm rất đáng ghé nếu muốn tụ tập cùng bạn bè sau giờ làm. Không gian tuy đơn giản nhưng sạch sẽ, thoáng mát, bàn ghế sắp xếp gọn gàng tạo cảm giác thoải mái.\n\nThực đơn đa dạng với nhiều món nhậu hấp dẫn, nêm nếm vừa miệng, nguyên liệu tươi và lên món khá nhanh. Giá cả hợp lý, phù hợp với nhiều đối tượng. Món gà nướng hơi ít, mấy món còn lại siêu ok.\n\nĐiểm cộng lớn là nhân viên nhiệt tình, vui vẻ và phục vụ chu đáo dù quán đông khách. Dù mình đi vào buổi trưa nhưng quán vẫn siêu đông khách nhe. Không khí nhộn nhịp, đồ ăn ngon, giá tốt và dịch vụ thân thiện khiến mình chắc chắn sẽ quay lại và giới thiệu cho bạn bè.","Images":["https://lh3.googleusercontent.com/grass-cs/ACvplmOQOaGeVgJdhrEYMSK5W4A1X_9Q9nQW1LPpZq4p3RdmxrE7P1xjHK7MH7_70C-tfp1QzOvJQ-SPhoRHTV0vUymtjaB3jxpFGnNqLiiJloWOnpt6Bz7rVz9Rxm5Rue8oOXj3JxVFPrXPCZB4=k-no","https://lh3.googleusercontent.com/grass-cs/ACvplmNRsl_Ir_PELWJ3J8y4p6KB3V5u5lEN4mt-zMgg92fwkhU39Qkq94j7KR_41Qpo7t4_T12SjZzJ0K_AF6tX7S6k9FNCJKYYNjVSkBUP-ViESIZSog1XwAiJXqD-P7tiDvlJk37CU8RQZs8a=k-no","https://lh3.googleusercontent.com/grass-cs/ACvplmNIjEfsyECjaKf2gIOcAYjKm2nIq0xpFR8lN7IjBb9Tqg5kAyhzwiYLF6TmghCDrm_lg0SR_MYrqog4suY-ENMeQ-j93qh5UPH6EWuO5tspqe3ZgduzzNavPXCNyDLRAbLCYdf5coV_aek=k-no","https://lh3.googleusercontent.com/grass-cs/ACvplmPPYDtlv6UXBx_MGqkRLU3EYMQ9nf5iN61MCQn_eZ5SvcHVDdSY_AjXcNYkL