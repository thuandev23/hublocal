,{"name":"Đồ ăn khuya","enabled":true},{"name":"Phần ăn nhỏ","enabled":true},{"name":"Rượu","enabled":true}]},{"id":"dining_options","name":"Lựa chọn ăn uống","options":[{"name":"Bữa tối","enabled":true},{"name":"Dịch vụ ăn uống","enabled":true},{"name":"Chỗ ngồi","enabled":true},{"name":"Phục vụ tại bàn","enabled":true}]},{"id":"amenities","name":"Tiện nghi","options":[{"name":"Nhà vệ sinh","enabled":true},{"name":"Wi-Fi","enabled":true}]},{"id":"atmosphere","name":"Bầu không khí","options":[{"name":"Thông thường","enabled":true}]},{"id":"crowd","name":"Khách hàng","options":[{"name":"Nhóm","enabled":true}]},{"id":"planning","name":"Lên kế hoạch","options":[{"name":"Nhận đặt chỗ","enabled":true}]},{"id":"payments","name":"Thanh toán","options":[{"name":"Thanh toán di động qua NFC","enabled":true},{"name":"Thẻ ghi nợ","enabled":true},{"name":"Thẻ tín dụng","enabled":false,"values":["Thẻ MasterCard"]}]},{"id":"parking","name":"Bãi đỗ xe","options":[{"name":"Bãi đỗ xe miễn phí","enabled":true},{"name":"Chỗ đỗ xe","enabled":false},{"name":"Đỗ xe miễn phí trên đường","enabled":true}]},{"id":"pets","name":"Thú cưng","options":[{"name":"Cho phép mang theo chó","enabled":true}]}],"user_reviews":[{"Name":"Pacyfic Nguyen","ProfilePicture":"https://lh3.googleusercontent.com/a-/ALV-UjXMSTyqs7nze2XLTOE31HoKgWeCReHBSOEXwSoHNXIGdV5oDA=s120-c-rp-mo-ba12-br100","Rating":5,"Description":"Quán có không gian rất thoáng mát, sạch sẽ và tạo cảm giác dễ chịu ngay từ lúc bước vào. Cách bố trí bàn ghế khá hợp lý, không quá chật chội nên dù đi cùng gia đình, bạn bè hay nhóm đông người vẫn cảm thấy thoải mái. Không khí trong quán khá thư giãn, phù hợp để vừa ăn uống vừa trò chuyện mà không bị quá ồn ào.\n\nĐồ ăn ở đây cũng là một điểm cộng lớn. Món ăn được chế biến ngon, nêm nếm vừa miệng, nguyên liệu cảm giác khá tươi và trình bày cũng đẹp mắt. Các món lên tương đối nhanh, vẫn giữ được độ nóng và hương vị. Menu có nhiều lựa chọn nên khá dễ gọi món cho nhiều người với sở thích khác nhau. Mình đặc biệt thích cách quán chăm chút từ món ăn đến cách phục vụ, tạo cảm giác rất chỉn chu.\n\nĐiểm mình ấn tượng nhất là các bạn nhân viên phục vụ rất dễ thương, nhiệt tình và thân thiện. Khi khách cần hỗ trợ hay gọi thêm món đều phản hồi nhanh, nói chuyện vui vẻ và lịch sự. Dù lúc đông khách vẫn giữ thái độ niềm nở, không tạo cảm giác khó chịu hay phải chờ đợi quá lâu.\n\nNhìn chung đây là một quán có không gian đẹp, thoáng mát, đồ ăn ngon và dịch vụ tốt. Trải nghiệm khá hài lòng và mình chắc chắn sẽ quay lại nếu có dịp. Rất phù hợp để đi ăn cùng gia đình, bạn bè hoặc tụ tập cuối tuần.","Images":["https://lh3.googleusercontent.com/grass-cs/ACvplmPyxTKmJUmf8FnZOhWpY3ocOJ7ctTSqMrxxt77XOP1-K1m3ENHfPkbYKFxcAMM-OmdE9p9iXsvhIuzXUAGJRfZGEeKhJNNeU_01GuU1tvJ_yPzyB0Rb__-cyj-Vku3ieixvNd0kSybkV4Jy=k-no","https://lh3.googleusercontent.com/grass-cs/ACvplmMFdAXldUymmlY3jibUZxVdUadCLWkrHEp2_lkiD7Ig3nCmpGNt83G6oGmsY2Stq-Ob9d8ZR4BChjvDjnSPhxc2HGnb-qH61LktZedc7W27YapEknAn2heFTl8RtktC6q_8g8_JTxnOym40=k-no","https://lh3.googleusercontent.com/grass-cs/ACvplmMGL1ZjdT5J2mkldvMbyuj3T6_45KnMsb82OX5S0KcWVFx-wg3aisNBEcCzGkYZLGtJNt4pwyctY4xFaiDydcTOvt5crM5xAJXOmp4hqTZoGiazf5RY5RT4HDkkv3QMI-peH0Wb0kWivcY=k-no","https://lh3.googleusercontent.com/grass-cs/ACvplmNFLUDQ_lI2kfxGcjBtVuilKNVipj-XMEftylXEba88cSSCkph0Rf7dezDg5u_-sUo2WdykTZhhCgqvWa7jU3MaeKcAytWTu9VGMPAW7DMN0d64gx5Gs8qr-nxRSsydRO-Qgs70y-Uy8Yr3=k-no","https://lh3.googleusercontent.com/grass-cs/ACvplmMIxGTphKJ0eJ2hveu4zwPd-sznPI1fpnlvdcYOepnpdb8QrTrys-wR1R5Efe9_NX9x3GfWzk0klZkGiB0EWuOt636vPR3yXJ7ry0Gt2XoyURXBpE4DD_uDfu4D3vPcM1Hcu14oLvR8L7iG=k-no","https://lh3.googleusercontent.com/grass-cs/ACvplmPD2Ra420PM0cN-iiKY8ZO3PFnwWm6sQt9mDovk3W47JwvOI5ihvK9pvVliwiNVXr02E7CHrKWVC2jeP-NF5mqai4L7ylTxSd6ZAwvP_t195JhGBJQH5I-YEiPpPMHK5de9x8jwEIv5lcs=k-no","https://lh3.googleusercontent.com/grass-cs/ACvplmNvy5eivgBvdUlbfcbOH2RGs-Ic2JhNeYauAa7eVOaWZ8yiGraRnJjdjiS0IuaNTn-voSmXNOT8J50C3WP8ms2RLaqfubO3myuWBdBdHZEcxMzhzRljghrDYQW13hdJa7BHWECuPY8mPoM=k-no","ht