e":"Chỗ ngồi","enabled":true},{"name":"Phục vụ tại bàn","enabled":true}]},{"id":"amenities","name":"Tiện nghi","options":[{"name":"Nhà vệ sinh","enabled":true}]},{"id":"atmosphere","name":"Bầu không khí","options":[{"name":"Ấm cúng","enabled":true},{"name":"Lãng mạn","enabled":true},{"name":"Thông thường","enabled":true},{"name":"Yên tĩnh","enabled":true}]},{"id":"crowd","name":"Khách hàng","options":[{"name":"Nhóm","enabled":true},{"name":"Sinh viên","enabled":true}]},{"id":"planning","name":"Lên kế hoạch","options":[{"name":"Nhận đặt chỗ","enabled":true}]},{"id":"children","name":"Trẻ em","options":[{"name":"Phù hợp cho trẻ em","enabled":true}]},{"id":"parking","name":"Bãi đỗ xe","options":[{"name":"Bãi đỗ xe miễn phí","enabled":true},{"name":"Chỗ đỗ xe","enabled":false},{"name":"Đỗ xe miễn phí trên đường","enabled":true}]}],"user_reviews":[{"Name":"Quý Mai","ProfilePicture":"https://lh3.googleusercontent.com/a-/ALV-UjVYBFBv7ZA9vj3bw7oOfOhd2OidnIJDNqdsG8Auk2Y0qgisVPw=s120-c-rp-mo-ba12-br100","Rating":3,"Description":"DOME nằm ngay ngã tư Bác Ái và Chu Mạnh Trinh, 2 mặt tiền thoáng mát. Quán có không gian ngồi trong và ngoài, tuy nhiên ngồi ngoài thoáng và đỡ ồn hơn, bên trong quán mở nhạc lớn nên mọi người cũng sẽ nói chuyện khá ồn.\nVề nước: tụi mình gọi 2 trà chôm chôm 45k/ly, cảm giác siêu ngọt, đầy sirup, không cảm nhận được vị trà, tụi mình ngồi chờ đá tan mới uống được. So với mức giá thì trải nghiệm đồ uống ở đây chưa trọn vẹn.","Images":["https://lh3.googleusercontent.com/grass-cs/ACvplmNV401B3FjGB93DZnSgabXwjcT1GmIlcWTSlwGB01C5ERR_Qbr7ac0flf0QlY6plgOgqWHzKzN2zl-imr1bykTMDjZcX43iYTouEQQYAgJhBpLQT4BWy93e0zF2buWba28c9YOkmvea42yx=k-no","https://lh3.googleusercontent.com/grass-cs/ACvplmPJbul1nkZulGtr5NoWiiw06u6ZMPRKrwqlGVe1Yw8NchRQ9O0WcUIzVW5BnAXAM7QziS70fQimIHEn4jFjEQLJYJgbXoio0W-oYSHECo6VS9XwU-b81HyVZsOl30FOeCWKs02USghgOI4=k-no","https://lh3.googleusercontent.com/grass-cs/ACvplmMIekdgFrCSqsLRugRPHOhqBXSy67d2DQy8vyPFJ0ZD05KR2nvfXbImMc8_ONDQZsneBo2DAa9eWDH5JH