:""},"complete_address":{"borough":"Thủ Đức","street":"88/3 Đ. Võ Văn Ngân","city":"Hồ Chí Minh","postal_code":"","state":"Thủ Đức, Hồ Chí Minh","country":"VN"},"credit_cards_accepted":null,"about":[{"id":"service_options","name":"Các tùy chọn dịch vụ","options":[{"name":"Đồ ăn mang đi","enabled":true},{"name":"Ăn tại chỗ","enabled":true}]},{"id":"dining_options","name":"Lựa chọn ăn uống","options":[{"name":"Bữa trưa","enabled":true},{"name":"Dịch vụ ăn uống","enabled":true},{"name":"Phục vụ tại bàn","enabled":true}]},{"id":"amenities","name":"Tiện nghi","options":[{"name":"Nhà vệ sinh","enabled":true}]},{"id":"atmosphere","name":"Bầu không khí","options":[{"name":"Thông thường","enabled":true}]},{"id":"crowd","name":"Khách hàng","options":[{"name":"Nhóm","enabled":true}]},{"id":"parking","name":"Bãi đỗ xe","options":[{"name":"Bãi đỗ xe miễn phí","enabled":true},{"name":"Đỗ xe miễn phí trên đường","enabled":true}]}],"user_reviews":[{"Name":"Bơ","ProfilePicture":"https://lh3.googleusercontent.com/a-/ALV-UjWt9KaviZ_m7shMJMrshqb16gBBbTS9sFTHELK_70XM5ZJZc7D_4w=s120-c-rp-mo-ba12-br100","Rating":5,"Description":"Thử khá nhiều quán cơm tấm Thủ Đức nhưng mình cực kỳ ấn tượng cơm ở đây. Đĩa cơm tròn vị từ sườn, bì, cho đến chả, trứng với giá 50k mình thấy cũng khá ổn, ko cao lắm.\nMắm đúng gu mình luôn, kẹo vừa, ngọt mặn vừa phải. Sườn hôm mình ăn quán ướp hơi nhạt tí, chưa được ngấm gia vị lắm.\nQuán vào giờ cao điểm hơi đông, đợi tầm 5-10p sẽ có cơm. Không gian quán trong nhà, nướng thịt được hút khói đẩy ra ngoài nên cũng đỡ ngợp xíu.","Images":["https://lh3.googleusercontent.com/grass-cs/AABkmLf3bxoCQ_RjLQsrCPB1fz51rwdTcHt3yj9xOZQlXJ1sfVrooUsTcrIf-UYh1ddCrRNgze4mSDzjc4j1VRHtUkDznbbcSoQBKH202gmAdmwEO4f1yyaIa_jtYAGmfH_gAu_Rkb5mOYNh35s=k-no","https://lh3.googleusercontent.com/grass-cs/AABkmLcp0ZKac-MaQKENWM98diO4wBJh_XvSdZ2rktQzjSpczM2hqROMFSVuZNO-640eUYRycqskhhkxefr2KF0ueb34jgmfu8vQkYVsEIs0Hm_L9HcTpqfqajWlvUVOBsAcZzFZfSY5F62PJZe4=k-no","https://lh3.googleusercontent.com/